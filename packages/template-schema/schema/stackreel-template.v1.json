{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DevaanshMann/StackReel/main/packages/template-schema/schema/stackreel-template.v1.json",
  "$ref": "#/$defs/Template",
  "$defs": {
    "Template": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "number", "const": 1 },
        "id": { "$ref": "#/$defs/Id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "maxLength": 500 },
        "canvas": { "$ref": "#/$defs/Canvas" },
        "durationUs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Total length of the template."
        },
        "audio": { "$ref": "#/$defs/Audio" },
        "slots": { "type": "array", "items": { "$ref": "#/$defs/Slot" } },
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/Track" } },
        "safeZones": { "$ref": "#/$defs/SafeZones" }
      },
      "required": ["schemaVersion", "id", "name", "canvas", "durationUs", "slots", "tracks"],
      "additionalProperties": false,
      "title": "StackReel Template",
      "description": "A StackReel template (SRT-JSON). All times are integer microseconds; positions are normalized 0-1."
    },
    "Id": { "type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$" },
    "Canvas": {
      "type": "object",
      "properties": {
        "width": { "type": "integer", "minimum": 16, "maximum": 8192, "description": "Output width in pixels." },
        "height": { "type": "integer", "minimum": 16, "maximum": 8192, "description": "Output height in pixels." },
        "fps": { "type": "integer", "minimum": 1, "maximum": 240, "description": "Frames per second." },
        "background": { "description": "Fill behind all tracks.", "default": "#000000", "$ref": "#/$defs/Color" }
      },
      "required": ["width", "height", "fps"],
      "additionalProperties": false
    },
    "Color": {
      "type": "string",
      "pattern": "^#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$",
      "description": "Hex color, #RRGGBB or #RRGGBBAA."
    },
    "Audio": {
      "type": "object",
      "properties": {
        "music": { "$ref": "#/$defs/Music" },
        "duckMusicUnderVoice": {
          "description": "Lower the music while a clip has speech.",
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Music": {
      "type": "object",
      "properties": {
        "slot": { "description": "Id of an audio slot.", "$ref": "#/$defs/Id" },
        "startUs": { "description": "When the music starts.", "default": 0, "$ref": "#/$defs/Microseconds" },
        "gainDb": {
          "default": 0,
          "type": "number",
          "minimum": -60,
          "maximum": 12,
          "description": "Gain in dB, from -60 to +12. 0 is unchanged."
        },
        "fadeInUs": { "$ref": "#/$defs/Microseconds" },
        "fadeOutUs": { "$ref": "#/$defs/Microseconds" }
      },
      "required": ["slot"],
      "additionalProperties": false
    },
    "Microseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "Time in integer microseconds (1 s = 1000000). Never a float."
    },
    "Slot": {
      "oneOf": [
        { "$ref": "#/$defs/VideoSlot" },
        { "$ref": "#/$defs/ImageSlot" },
        { "$ref": "#/$defs/AudioSlot" },
        { "$ref": "#/$defs/TextSlot" }
      ]
    },
    "VideoSlot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Shown to the user when they fill the slot."
        },
        "optional": { "description": "The template renders without this slot.", "default": false, "type": "boolean" },
        "kind": { "type": "string", "const": "video" },
        "minDurationUs": {
          "description": "Shortest clip that fills the slot without padding.",
          "$ref": "#/$defs/Microseconds"
        }
      },
      "required": ["id", "label", "kind"],
      "additionalProperties": false
    },
    "ImageSlot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Shown to the user when they fill the slot."
        },
        "optional": { "description": "The template renders without this slot.", "default": false, "type": "boolean" },
        "kind": { "type": "string", "const": "image" }
      },
      "required": ["id", "label", "kind"],
      "additionalProperties": false
    },
    "AudioSlot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Shown to the user when they fill the slot."
        },
        "optional": { "description": "The template renders without this slot.", "default": false, "type": "boolean" },
        "kind": { "type": "string", "const": "audio" },
        "minDurationUs": { "$ref": "#/$defs/Microseconds" }
      },
      "required": ["id", "label", "kind"],
      "additionalProperties": false
    },
    "TextSlot": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Shown to the user when they fill the slot."
        },
        "optional": { "description": "The template renders without this slot.", "default": false, "type": "boolean" },
        "kind": { "type": "string", "const": "text" },
        "maxChars": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
      },
      "required": ["id", "label", "kind"],
      "additionalProperties": false
    },
    "Track": {
      "oneOf": [{ "$ref": "#/$defs/VideoTrack" }, { "$ref": "#/$defs/OverlayTrack" }, { "$ref": "#/$defs/AudioTrack" }],
      "description": "Tracks are ordered bottom to top."
    },
    "VideoTrack": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string", "const": "video" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/MediaItem" } }
      },
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "description": "Video and image clips, played in sequence. Items must not overlap."
    },
    "MediaItem": {
      "type": "object",
      "properties": {
        "slot": { "description": "Id of the slot whose media plays here.", "$ref": "#/$defs/Id" },
        "startUs": {
          "description": "When the item starts, relative to the template start.",
          "$ref": "#/$defs/Microseconds"
        },
        "durationUs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A non-zero length of time in integer microseconds."
        },
        "fit": { "default": "cover", "$ref": "#/$defs/FitMode" },
        "speed": {
          "description": "Playback rate, 0.25 to 4.",
          "default": 1,
          "type": "number",
          "minimum": 0.25,
          "maximum": 4
        },
        "gainDb": {
          "default": 0,
          "type": "number",
          "minimum": -60,
          "maximum": 12,
          "description": "Gain in dB, from -60 to +12. 0 is unchanged."
        },
        "fadeInUs": { "$ref": "#/$defs/Microseconds" },
        "fadeOutUs": { "$ref": "#/$defs/Microseconds" },
        "transitionIn": { "$ref": "#/$defs/Transition" }
      },
      "required": ["slot", "startUs", "durationUs"],
      "additionalProperties": false
    },
    "FitMode": { "type": "string", "enum": ["cover", "contain", "fill"], "description": "How media fills the canvas." },
    "Transition": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/TransitionType" },
        "durationUs": { "$ref": "#/$defs/Microseconds" },
        "direction": { "description": "For slide and whip-pan.", "default": "left", "$ref": "#/$defs/Direction" }
      },
      "required": ["type", "durationUs"],
      "additionalProperties": false,
      "description": "Plays across the cut at the start of the item that owns it."
    },
    "TransitionType": { "type": "string", "enum": ["cut", "crossfade", "whip-pan", "zoom-punch", "slide", "spin"] },
    "Direction": { "type": "string", "enum": ["left", "right", "up", "down"] },
    "OverlayTrack": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string", "const": "overlay" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/OverlayItem" } }
      },
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "description": "Text and stickers drawn over the tracks below."
    },
    "OverlayItem": { "oneOf": [{ "$ref": "#/$defs/TextItem" }, { "$ref": "#/$defs/StickerItem" }] },
    "TextItem": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "text" },
        "startUs": {
          "description": "When the item starts, relative to the template start.",
          "$ref": "#/$defs/Microseconds"
        },
        "durationUs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A non-zero length of time in integer microseconds."
        },
        "slot": { "description": "A text slot whose value replaces text.default.", "$ref": "#/$defs/Id" },
        "text": {
          "type": "object",
          "properties": {
            "default": { "type": "string", "description": "Text shown until the user edits it." },
            "editable": { "type": "boolean" },
            "maxChars": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
          },
          "required": ["default"],
          "additionalProperties": false
        },
        "style": {
          "default": { "font": "Inter-Bold", "sizePx": 64, "color": "#FFFFFF", "align": "center" },
          "$ref": "#/$defs/Style"
        },
        "position": {
          "default": { "anchor": "center", "x": 0.5, "y": 0.5, "rotationDeg": 0 },
          "$ref": "#/$defs/Position"
        },
        "animation": { "$ref": "#/$defs/Animation" }
      },
      "required": ["kind", "startUs", "durationUs", "text"],
      "additionalProperties": false
    },
    "Style": {
      "type": "object",
      "properties": {
        "font": {
          "type": "string",
          "minLength": 1,
          "description": "PostScript name of a bundled font, e.g. Inter-Black."
        },
        "sizePx": { "type": "number", "exclusiveMinimum": 0, "description": "Font size in pixels at the canvas size." },
        "color": { "$ref": "#/$defs/Color" },
        "align": { "default": "center", "type": "string", "enum": ["left", "center", "right"] },
        "stroke": {
          "type": "object",
          "properties": { "color": { "$ref": "#/$defs/Color" }, "widthPx": { "type": "number", "minimum": 0 } },
          "required": ["color", "widthPx"],
          "additionalProperties": false
        },
        "shadow": {
          "type": "object",
          "properties": {
            "color": { "$ref": "#/$defs/Color" },
            "blurPx": { "type": "number", "minimum": 0 },
            "offsetXPx": { "type": "number" },
            "offsetYPx": { "type": "number" }
          },
          "required": ["color", "blurPx", "offsetXPx", "offsetYPx"],
          "additionalProperties": false
        },
        "background": {
          "type": "object",
          "properties": {
            "color": { "$ref": "#/$defs/Color" },
            "paddingPx": { "type": "number", "minimum": 0 },
            "cornerRadiusPx": { "type": "number", "minimum": 0 }
          },
          "required": ["color", "paddingPx", "cornerRadiusPx"],
          "additionalProperties": false
        }
      },
      "required": ["font", "sizePx", "color"],
      "additionalProperties": false
    },
    "Position": {
      "type": "object",
      "properties": {
        "anchor": { "$ref": "#/$defs/Anchor" },
        "x": { "$ref": "#/$defs/Normalized" },
        "y": { "$ref": "#/$defs/Normalized" },
        "rotationDeg": { "default": 0, "type": "number", "minimum": -360, "maximum": 360 }
      },
      "required": ["anchor", "x", "y"],
      "additionalProperties": false
    },
    "Anchor": {
      "type": "string",
      "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"],
      "description": "Which point of the element sits at (x, y)."
    },
    "Normalized": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "A value relative to the canvas, from 0 to 1."
    },
    "Animation": {
      "type": "object",
      "properties": {
        "in": { "$ref": "#/$defs/AnimationName" },
        "out": { "$ref": "#/$defs/AnimationName" },
        "inDurationUs": { "default": 300000, "$ref": "#/$defs/Microseconds" },
        "outDurationUs": { "default": 300000, "$ref": "#/$defs/Microseconds" }
      },
      "additionalProperties": false
    },
    "AnimationName": {
      "type": "string",
      "enum": [
        "none",
        "fade",
        "pop",
        "slide-up",
        "slide-down",
        "slide-left",
        "slide-right",
        "scale",
        "typewriter",
        "bounce"
      ]
    },
    "StickerItem": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "const": "sticker" },
        "startUs": {
          "description": "When the item starts, relative to the template start.",
          "$ref": "#/$defs/Microseconds"
        },
        "durationUs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "A non-zero length of time in integer microseconds."
        },
        "asset": {
          "type": "string",
          "minLength": 1,
          "description": "Id of a sticker bundled with the app or template."
        },
        "widthNorm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "description": "Sticker width relative to the canvas width."
        },
        "position": {
          "default": { "anchor": "center", "x": 0.5, "y": 0.5, "rotationDeg": 0 },
          "$ref": "#/$defs/Position"
        },
        "animation": { "$ref": "#/$defs/Animation" }
      },
      "required": ["kind", "startUs", "durationUs", "asset", "widthNorm"],
      "additionalProperties": false
    },
    "AudioTrack": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "type": "string", "const": "audio" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/MediaItem" } }
      },
      "required": ["id", "type", "items"],
      "additionalProperties": false,
      "description": "Audio clips such as voice-over or sound effects."
    },
    "SafeZones": {
      "type": "object",
      "properties": {
        "preset": { "$ref": "#/$defs/SafeZonePreset" },
        "insets": {
          "description": "Overrides the preset. Each value is a fraction of the canvas edge.",
          "type": "object",
          "properties": {
            "top": { "$ref": "#/$defs/Normalized" },
            "bottom": { "$ref": "#/$defs/Normalized" },
            "left": { "$ref": "#/$defs/Normalized" },
            "right": { "$ref": "#/$defs/Normalized" }
          },
          "required": ["top", "bottom", "left", "right"],
          "additionalProperties": false
        }
      },
      "required": ["preset"],
      "additionalProperties": false,
      "description": "Areas covered by platform UI, where editors warn about placing text."
    },
    "SafeZonePreset": {
      "type": "string",
      "enum": ["none", "tiktok-reels-shorts", "tiktok", "instagram-reels", "youtube-shorts"]
    }
  }
}
