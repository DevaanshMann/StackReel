  "slots": [
    { "id": "title", "kind": "text", "label": "List title", "maxChars": 36 },
    { "id": "item5", "kind": "video", "label": "Number 5", "minDurationUs": 4000000 },
    { "id": "item4", "kind": "video", "label": "Number 4", "minDurationUs": 4000000 },
    { "id": "item3", "kind": "video", "label": "Number 3", "minDurationUs": 4000000 },
    { "id": "item2", "kind": "video", "label": "Number 2", "minDurationUs": 4000000 },
    { "id": "item1", "kind": "video", "label": "Number 1", "minDurationUs": 4000000 },
    { "id": "name5", "kind": "text", "label": "Name of number 5", "maxChars": 24 },
    { "id": "name4", "kind": "text", "label": "Name of number 4", "maxChars": 24 },
    { "id": "name3", "kind": "text", "label": "Name of number 3", "maxChars": 24 },
