{
  "schemaVersion": 1,
  "id": "top-5-countdown",
  "name": "Top 5 Countdown",
  "description": "A list title, then five picks counted down from 5 to 1 with big numbers and names, ending on the winner.",
  "canvas": { "width": 1080, "height": 1920, "fps": 30, "background": "#000000" },
  "durationUs": 25000000,
  "audio": {
    "music": { "slot": "music", "startUs": 0, "gainDb": -6, "fadeOutUs": 1000000 },
    "duckMusicUnderVoice": true
