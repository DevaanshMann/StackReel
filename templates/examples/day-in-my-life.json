{
  "schemaVersion": 1,
  "id": "day-in-my-life",
  "name": "Day in My Life",
  "description": "Ten moments from morning to night at 24 fps, each stamped with an editable time, under a voice-over with ducked music.",
  "canvas": { "width": 1080, "height": 1920, "fps": 24, "background": "#000000" },
  "durationUs": 60000000,
  "audio": {
    "music": { "slot": "music", "startUs": 0, "gainDb": -8, "fadeInUs": 2000000, "fadeOutUs": 2000000 },
    "duckMusicUnderVoice": true
  },
  "slots": [
    { "id": "wake", "kind": "video", "label": "Waking up", "minDurationUs": 5000000 },
    { "id": "coffee", "kind": "video", "label": "Morning coffee", "minDurationUs": 5000000 },
    { "id": "commute", "kind": "video", "label": "Commute", "minDurationUs": 10000000 },
    { "id": "work", "kind": "video", "label": "Work", "minDurationUs": 10500000 },
    { "id": "lunch", "kind": "video", "label": "Lunch", "minDurationUs": 6000000 },
    { "id": "gym", "kind": "video", "label": "Workout", "minDurationUs": 6000000 },
    { "id": "errands", "kind": "video", "label": "Errands", "minDurationUs": 7500000 },
    { "id": "dinner", "kind": "video", "label": "Making dinner", "minDurationUs": 7000000 },
    { "id": "unwind", "kind": "video", "label": "Winding down", "minDurationUs": 7000000 },
    { "id": "night", "kind": "video", "label": "Lights out", "minDurationUs": 6000000 },
    { "id": "intro", "kind": "text", "label": "Intro line", "maxChars": 40 },
    { "id": "voiceover", "kind": "audio", "label": "Voice-over", "optional": true, "minDurationUs": 50000000 },
    { "id": "music", "kind": "audio", "label": "Background music", "optional": true }
  ],
  "tracks": [
    {
      "id": "main",
      "type": "video",
      "items": [
        { "slot": "wake", "startUs": 0, "durationUs": 5000000, "fit": "cover", "gainDb": -20 },
        { "slot": "coffee", "startUs": 5000000, "durationUs": 5000000, "fit": "cover", "gainDb": -20 },
        {
          "slot": "commute",
          "startUs": 10000000,
          "durationUs": 5000000,
          "fit": "cover",
          "speed": 2,
          "gainDb": -20,
          "transitionIn": { "type": "cut", "durationUs": 0 }
        },
        {
          "slot": "work",
          "startUs": 15000000,
          "durationUs": 7000000,
          "fit": "cover",
          "speed": 1.5,
          "gainDb": -20,
          "transitionIn": { "type": "crossfade", "durationUs": 400000 }
        },
        {
          "slot": "lunch",
          "startUs": 22000000,
          "durationUs": 6000000,
          "fit": "cover",
          "gainDb": -20,
          "transitionIn": { "type": "crossfade", "durationUs": 400000 }
        },
        {
          "slot": "gym",
          "startUs": 28000000,
          "durationUs": 6000000,
          "fit": "cover",
          "gainDb": -20,
          "transitionIn": { "type": "zoom-punch", "durationUs": 200000 }
        },
        {
          "slot": "errands",
          "startUs": 34000000,
          "durationUs": 6000000,
          "fit": "cover",
          "speed": 1.25,
          "gainDb": -20,
          "transitionIn": { "type": "slide", "durationUs": 350000, "direction": "left" }
        },
        {
          "slot": "dinner",
          "startUs": 40000000,
          "durationUs": 7000000,
          "fit": "cover",
          "gainDb": -20,
          "transitionIn": { "type": "crossfade", "durationUs": 400000 }
        },
        {
          "slot": "unwind",
          "startUs": 47000000,
          "durationUs": 7000000,
          "fit": "cover",
          "gainDb": -20,
          "transitionIn": { "type": "crossfade", "durationUs": 500000 }
        },
        {
          "slot": "night",
          "startUs": 54000000,
          "durationUs": 6000000,
          "fit": "cover",
          "gainDb": -20,
          "fadeOutUs": 1000000,
          "transitionIn": { "type": "crossfade", "durationUs": 600000 }
        }
      ]
    },
    {
      "id": "voice",
      "type": "audio",
      "items": [
        {
          "slot": "voiceover",
          "startUs": 1000000,
          "durationUs": 58000000,
          "gainDb": 0,
          "fadeInUs": 100000,
          "fadeOutUs": 500000
