{
  "schemaVersion": 1,
  "id": "hook-and-reveal",
  "name": "Hook & Reveal",
  "description": "A 3-clip template: hook text over clip 1, quick cut, reveal on clip 3.",
  "canvas": { "width": 1080, "height": 1920, "fps": 30, "background": "#000000" },
  "durationUs": 9000000,
  "audio": {
    "music": { "slot": "music", "startUs": 0, "gainDb": -6, "fadeOutUs": 500000 },
    "duckMusicUnderVoice": true
  },
  "slots": [
    { "id": "clip1", "kind": "video", "label": "Your hook shot", "minDurationUs": 3000000 },
    { "id": "clip2", "kind": "video", "label": "B-roll", "minDurationUs": 2000000 },
    { "id": "clip3", "kind": "video", "label": "The reveal", "minDurationUs": 4000000 },
    { "id": "music", "kind": "audio", "label": "Background music", "optional": true }
  ],
  "tracks": [
    {
      "id": "main",
      "type": "video",
      "items": [
        { "slot": "clip1", "startUs": 0, "durationUs": 3000000, "fit": "cover" },
        {
          "slot": "clip2",
          "startUs": 3000000,
          "durationUs": 2000000,
          "fit": "cover",
          "transitionIn": { "type": "whip-pan", "durationUs": 250000 }
        },
        {
          "slot": "clip3",
          "startUs": 5000000,
          "durationUs": 4000000,
          "fit": "cover",
          "transitionIn": { "type": "zoom-punch", "durationUs": 200000 }
        }
      ]
    },
    {
      "id": "text",
      "type": "overlay",
      "items": [
        {
          "kind": "text",
          "startUs": 200000,
          "durationUs": 2600000,
          "text": { "default": "Wait for it…", "editable": true, "maxChars": 40 },
          "style": {
            "font": "Inter-Black",
            "sizePx": 96,
            "color": "#FFFFFF",
            "stroke": { "color": "#000000", "widthPx": 6 }
          },
          "position": { "anchor": "center", "x": 0.5, "y": 0.22 },
          "animation": { "in": "pop", "out": "fade" }
        }
      ]
    }
  ],
  "safeZones": { "preset": "tiktok-reels-shorts" }
}
